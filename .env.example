# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/goldadam_crm

# JWT signing secret (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret

# Seed admin credentials (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@goldadam.local
SEED_ADMIN_PASSWORD=admin123

# Shared secret the browser extension uses for ingest/commands auth (optional layer)
EXTENSION_API_KEY=change-me-extension-key

# Twilio (SMS). Used for agent route-assignment texts and the two-way
# customer appointment-confirmation flow (send-confirmations + inbound webhook).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=change-me-twilio-auth-token
# Fallback "from" number for customer confirmation texts when a booking's
# agent has no agent.twilioNumber set.
TWILIO_FROM_NUMBER=+15555550100
# In the Twilio Console, under this number's Messaging config, set
# "A MESSAGE COMES IN" to a POST webhook pointing at:
#   https://<your-deployed-domain>/api/twilio/inbound

# Shared secret for Vercel Cron to call send-confirmations/send-reminders
# unattended (see vercel.json). Vercel sends this automatically as
# `Authorization: Bearer $CRON_SECRET` on cron-triggered requests once this
# var is set in the Vercel project's env vars too (not just locally).
CRON_SECRET=change-me-to-a-long-random-secret

# --- Headless scraper (scraper/) ---
# goldadam site + this CRM's own API base URL (as the scraper sees it)
GOLDADAM_URL=https://agent.goldadam.us
CRM_BASE_URL=http://localhost:3000
# Dedicated CRM login the scraper authenticates as (create via `npm run seed`
# or the admin UI — do not reuse your personal login here)
SCRAPER_CRM_EMAIL=scraper@goldadam.local
SCRAPER_CRM_PASSWORD=change-me-scraper-password
# Phone number that gets a text if the goldadam session expires or a run fails
ALERT_PHONE_NUMBER=+15555550101
# Cron expression for scraper/scheduler.js (default: 7am daily)
DAILY_RUN_CRON=0 7 * * *
# Cron expression for the sales scrape (default: 8am daily, after bookings)
SALES_RUN_CRON=0 8 * * *
# Date-range filter clicked on /sales before scraping: "Today", "Last Week"
# (default), "Last Month", "Year to Date", or "All Time". Keep this narrow
# for the daily job — it only needs to catch new sales and recent status
# changes (e.g. Pending -> Paid), not re-walk the whole history every day.
# "All Time" is for one-off backfills only (run scraper:sales-run manually
# with SALES_DATE_RANGE=All Time set for that one run) — re-scraping
# everything daily multiplies request volume against goldadam for no
# benefit and risks tripping their rate limiting / bot protection.
SALES_DATE_RANGE=Last Week
